@model DashboardViewModel

@{
    ViewData["Title"] = "Phone Assignments";
}

<div class="heading">
    <div>
        <div class="eyebrow">OPERATIONS DASHBOARD</div>
        <h1>Phone assignments<span class="dot">.</span></h1>
        <p class="subtitle">Manage team phone numbers with clarity and confidence.</p>
    </div>
    <span class="pill"><span class="online"></span> System active</span>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert success" role="status">✓ @success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert error" role="alert">! @error</div>
}

<div class="stats">
    <div class="stat">
        <span class="stat-icon purple">♙</span>
        <div>
            <small>TEAM MEMBERS</small>
            <strong>@Model.Members.Count</strong>
            <span>Total employees</span>
        </div>
    </div>
    <div class="stat">
        <span class="stat-icon blue">✓</span>
        <div>
            <small>ASSIGNED NUMBERS</small>
            <strong>@Model.AssignedCount</strong>
            <span>Currently in use</span>
        </div>
    </div>
    <div class="stat">
        <span class="stat-icon green">◈</span>
        <div>
            <small>AVAILABLE NUMBERS</small>
            <strong>@Model.AvailableCount</strong>
            <span>Ready to assign</span>
        </div>
    </div>
</div>

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Team directory</h2>
            <p>Review and manage employee phone assignments</p>
        </div>
        <span class="count">@Model.Members.Count members</span>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>TEAM MEMBER</th>
                    <th>CURRENT PHONE</th>
                    <th>STATUS</th>
                    <th>MANAGE ASSIGNMENT</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model.Members)
                {
                    <tr>
                        <td>
                            <div class="person">
                                <span class="initials">@member.Name.Substring(0, 1)</span>
                                <div>
                                    <strong>@member.Name</strong>
                                    <small>Team member · #@member.Id</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="phone">@(member.PhoneNumber ?? "—")</span>
                        </td>
                        <td>
                            @if (member.PhoneId is not null)
                            {
                                <span class="badge assigned">
                                    <span class="bullet"></span> Assigned
                                </span>
                            }
                            else
                            {
                                <span class="badge available">
                                    <span class="bullet"></span> Unassigned
                                </span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <form asp-action="Assign" method="post" class="assign-form">
                                    <input type="hidden" name="memberId" value="@member.Id" />
                                    <label class="sr-only" for="phone-@member.Id">
                                        Phone number for @member.Name
                                    </label>
                                    <select id="phone-@member.Id" name="phoneId" required>
                                        <option value="">Select number</option>
                                        @foreach (var phone in member.Choices)
                                        {
                                            if (member.PhoneId == phone.Id)
                                            {
                                                <option value="@phone.Id" selected>@phone.Number</option>
                                            }
                                            else
                                            {
                                                <option value="@phone.Id">@phone.Number</option>
                                            }
                                        }
                                    </select>
                                    <button class="btn primary" type="submit">Save</button>
                                </form>

                                @if (member.PhoneId is not null)
                                {
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="memberId" value="@member.Id" />
                                        <button class="btn outline"
                                                type="submit"
                                                onclick="return confirm('Remove this phone assignment?')">
                                            Remove
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="panel-footer">
        <span>ⓘ Each phone number can be assigned to only one team member.</span>
        <span>Changes are saved automatically</span>
    </div>
</section>

<footer class="footer">
    <span>Developed by Long Le | For Demonstration Purposes Only</span>
</footer>
